# ============================================================
# Public 환경 변수 (NEXT_PUBLIC_*)
# ⚠️ 이 값들은 클라이언트 번들에 그대로 포함됩니다.
#    절대 비밀(API 키, secret, password) 넣지 마세요.
# ============================================================

# 백엔드 API URL — Spring Boot(springdoc). server url 에 버전 prefix 없음 → **`/v1` 미포함**.
# 운영 BE:      https://trip-bite.o-r.kr
# Swagger UI:   https://trip-bite.o-r.kr/swagger-ui/index.html
# OpenAPI JSON: https://trip-bite.o-r.kr/v3/api-docs   (orval source = OPENAPI_URL)
#
# next.config.js rewrites 가 `/api/backend/:path*` → `${target}/:path*` 매핑하므로
# generated client 의 `/auth/login` → `/api/backend/auth/login` → `${target}/auth/login` 도달.
#
# Cross-origin 주의 — FE 도메인과 BE 도메인이 다르면 BE 가 다음을 설정해야 함:
#   Access-Control-Allow-Origin: <FE 도메인>
#   Access-Control-Allow-Credentials: true
#   Set-Cookie: SID=...; SameSite=None; Secure   (cross-origin cookie 전송 조건)
NEXT_PUBLIC_API_URL=https://trip-bite.o-r.kr

# Web Push (Push Notification 사용 시)
# 키 생성: `npx web-push generate-vapid-keys` 한 번.
# public 만 클라이언트(여기), private 은 서버 .env 의 VAPID_PRIVATE_KEY.
# 형식: 88자 base64url (B... 로 시작)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# MSW 활성화 (dev 전용). 'true' 일 때만 worker.start()
# 백엔드 미준비 상태에서 mock 응답으로 개발 진행할 때 사용.
# ⚠️ NEXT_PUBLIC_USE_MSW=true 시 robots noindex/nofollow 자동 적용
#    (mock 데이터가 검색 노출되지 않도록). 운영 배포 시 false 유지.
NEXT_PUBLIC_USE_MSW=false

# 명시적 robots 차단 — staging / preview 등에서 색인 막을 때.
# 운영 (prod) 에서는 'false' 또는 미설정 (정상 색인 허용).
NEXT_PUBLIC_BLOCK_INDEXING=false

# CSP enforce 토글 — 기본 Report-Only.
# Report-Only 로 1-2주 운영 후 violation 0건 확인되면 'true' 로 전환.
# 문제 발생 시 즉시 'false' 롤백.
NEXT_PUBLIC_CSP_ENFORCE=false

# 인증 마커 쿠키 이름 — FE(auth-store)가 로그인 시 set / 로그아웃·세션만료 시 clear.
# middleware 가 보호경로 게이팅에 이 쿠키를 본다. BE 세션 쿠키(JSESSIONID)를 직접
# 보지 않음 — 새 Spring 은 익명 요청에도 JSESSIONID 를 발급해 "쿠키=로그인" 이 성립
# 안 하기 때문. 기본값 tripbite.authed (미설정 시 사용).
NEXT_PUBLIC_AUTH_COOKIE=tripbite.authed

# 사이트 canonical URL — sitemap.xml / Open Graph url 등에 사용.
# 운영 (임시): https://trip-bite-mxue.vercel.app  (custom domain 받으면 갱신)
NEXT_PUBLIC_SITE_URL=https://trip-bite-mxue.vercel.app

# Pretendard CDN SRI integrity (선택, 운영 권장).
# 형식: 'sha384-<base64>'. jsdelivr 의 woff2 변경 시 갱신.
# 생성:
#   curl -sL "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" \
#     | openssl dgst -sha384 -binary | openssl base64 -A
# 현재 v1.3.9 기준 (2026-06-10 검증):
NEXT_PUBLIC_PRETENDARD_SRI=sha384-GIdEBaqGN9mNkDkMkzMHW8EKUqtpPIe/sLj1X7DIrnc9uPtLROJgmuDlh+3rBw0j

# ============================================================
# Server-only 환경 변수
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# Server Component / Route Handler / Server Action 에서만 사용.
# ============================================================

# Web Push private key (서버에서 push 전송 시 — NestJS 백엔드 .env 로 이동)
# 키 생성: `npx web-push generate-vapid-keys` 한 번 (public 과 쌍).
# 형식: 43자 base64url. 절대 git / 클라이언트 노출 X.
VAPID_PRIVATE_KEY=

# OpenAPI codegen 대상 URL (Spring Boot springdoc)
OPENAPI_URL=https://trip-bite.o-r.kr/v3/api-docs
