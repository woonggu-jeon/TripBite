# ============================================================
# Public 환경 변수 (NEXT_PUBLIC_*)
# ⚠️ 이 값들은 클라이언트 번들에 그대로 포함됩니다.
#    절대 비밀(API 키, secret, password) 넣지 마세요.
# ============================================================

# 백엔드 API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Web Push (Push Notification 사용 시)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry DSN — 설계상 public 으로 안전
NEXT_PUBLIC_SENTRY_DSN=

# MSW 활성화 (dev 전용). 'true' 일 때만 worker.start()
# 백엔드 미준비 상태에서 mock 응답으로 개발 진행할 때 사용
NEXT_PUBLIC_USE_MSW=false

# ============================================================
# Server-only 환경 변수
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# Server Component / Route Handler / Server Action 에서만 사용.
# ============================================================

# Web Push private key (서버에서 push 전송 시. 보통은 백엔드에 둠)
VAPID_PRIVATE_KEY=

# Sentry — 빌드 시 소스맵 업로드용 (CI secret)
SENTRY_AUTH_TOKEN=

# OpenAPI codegen 대상 URL
OPENAPI_URL=http://localhost:8080/v3/api-docs
