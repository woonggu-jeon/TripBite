[
  {
    "name": "Shared First Load — 모든 페이지 공통 다운로드 (framework + main + polyfills, gzip)",
    "path": [
      ".next/static/chunks/framework-*.js",
      ".next/static/chunks/main-*.js",
      ".next/static/chunks/polyfills-*.js"
    ],
    "limit": "150 kB",
    "gzip": true
  },
  {
    "name": "전체 chunks 합계 — lazy 포함 (정보용, eager bundle 과 무관). MSW 운영 false 가정으로 baseline 조정.",
    "path": [
      ".next/static/chunks/*.js",
      "!.next/static/chunks/main.js",
      "!.next/static/chunks/_*.js"
    ],
    "limit": "2 MB",
    "gzip": true
  }
]
