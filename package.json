{
  "name": "tripbite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "predev": "npm run generate:api || echo \"[predev] generate:api skipped — using committed src/api/generated/\"",
    "prebuild": "npm run generate:api || echo \"[prebuild] generate:api skipped — using committed src/api/generated/\"",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "generate:api": "orval --config ./orval.config.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "gen:splash": "node scripts/generate-ios-splash.mjs",
    "gen:favicon": "node scripts/generate-favicon.mjs",
    "prepare": "husky || true",
    "analyze": "ANALYZE=true next build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "next build && size-limit",
    "size:ci": "size-limit",
    "be:smoke": "node scripts/be-smoke.mjs",
    "be:anon": "node scripts/be-anon-flow.mjs",
    "be:onboarded": "node scripts/be-onboarded-flow.mjs",
    "be:login": "node scripts/be-login-redirect.mjs",
    "be:check": "npm run be:smoke && npm run be:anon && npm run be:onboarded && npm run be:login",
    "be:contract": "BE_CONTRACT=1 vitest run src/api/be-contract.test.ts",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --port 3000",
    "kill:3000": "node scripts/kill-port.mjs 3000",
    "kill:3901": "node scripts/kill-port.mjs 3901",
    "dev:restart": "npm run kill:3000 && npm run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "loadtest": "artillery run loadtest/scenarios.yml",
    "loadtest:report": "artillery run --output loadtest/report.json loadtest/scenarios.yml && artillery report --output loadtest/report.html loadtest/report.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@serwist/next": "^9.5.11",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.453.0",
    "next": "^15.5.19",
    "next-intl": "^4.13.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@faker-js/faker": "^10.5.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^11.2.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "artillery": "^2.0.33",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-storybook": "^10.4.6",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lucide-static": "^1.20.0",
    "msw": "^2.14.6",
    "orval": "^8.15.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "serwist": "^9.5.11",
    "sharp": "^0.35.1",
    "size-limit": "^11.2.0",
    "storybook": "^10.4.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
