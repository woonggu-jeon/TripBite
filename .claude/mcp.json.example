{
  "_comment": "Figma MCP server template. 사용법: 본 파일을 mcp.json 으로 복사 + FIGMA_API_KEY 의 placeholder 를 본인 token 으로 교체. 실제 mcp.json 은 .gitignore 에 의해 commit 안 됨. 자세히: docs/FIGMA_INTEGRATION.md §0-4.",
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "REPLACE_WITH_YOUR_FIGMA_TOKEN"
      }
    }
  }
}
